# ── Database (PostgreSQL) ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=watch_together

# ── JWT ────────────────────────────────────────────────────────────
# High-entropy secret used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRES_IN=24h

# ── Google OAuth ───────────────────────────────────────────────────
# Client ID from Google Cloud Console (used to verify ID tokens server-side)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Server ─────────────────────────────────────────────────────────
PORT=8080

# ── CORS ───────────────────────────────────────────────────────────
# Allowed origin for CORS (frontend URL). Use comma-separated for multiple.
CORS_ORIGIN=http://localhost:3000

# ── TMDB ───────────────────────────────────────────────────────────
TMDB_API_KEY=your-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3
