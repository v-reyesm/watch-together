{
  "name": "watch-together",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@8.6.0",
  "scripts": {
    "dev:web": "next dev",
    "dev:api": "pnpm --filter watch-together-backend run dev",
    "dev": "concurrently -n \"WEB,API\" -c \"magenta,blue\" \"pnpm run dev:web\" \"pnpm run dev:api\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "pnpm run test:e2e:web",
    "test:e2e:web": "playwright test",
    "test:e2e:web:headed": "playwright test --headed",
    "test:e2e:web:ui": "playwright test --ui"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.4",
    "lucide-react": "^0.563.0",
    "next": "15.2.8",
    "next-themes": "^0.4.6",
    "pg": "^8.18.0",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "eslint": "^9.7.0",
    "eslint-config-next": "15.2.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "next-router-mock": "^1.0.5",
    "postcss": "^8.4.31",
    "shadcn": "^3.8.4",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "next": "15.2.8",
      "multer": "^2.0.0"
    }
  }
}
