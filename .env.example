# ── Frontend (Next.js) ──────────────────────────────────────────────
# Internal URL of the NestJS API reachable from the Next.js server process
# (used for SSR calls and as the rewrite destination). Never exposed to the browser.
API_INTERNAL_URL=http://localhost:8080

# Google OAuth — client ID for Sign-in with Google button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
